# Copy to .env for docker compose. LOCAL VALUES ONLY - production reads real secrets from the environment.
APP_JWT_SECRET=local-dev-secret-change-me-at-least-32-chars
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh token cookie needs Secure=false over plain HTTP on localhost
APP_AUTH_COOKIE_SECURE=false
APP_MAIL_FROM=ASMS <no-reply@asms.local>
# SMTP: leave empty to use Mailpit (http://localhost:8025). For Gmail use an App Password, never the account password.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=
MAIL_STARTTLS=
# First Admin account, created on startup when no Admin exists (FR-AUTH-24). Remove the password after the first run.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@asms.local
# User ID the first Admin signs in with (students sign in with their MSSV as User ID)
APP_BOOTSTRAP_ADMIN_USER_CODE=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=Quantri2026
# GitHub OAuth App (Settings > Developer settings > OAuth Apps); callback http://localhost:5173/settings/profile/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Object storage (AWS S3; set STORAGE_ENDPOINT only for Cloudflare R2 / MinIO). Bucket policy: public read on avatars/*
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com
